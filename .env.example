# Base de données (par défaut : SQLite dans data/aeroops.db)
# DATABASE_URL=postgresql+psycopg2://aeroops:aeroops@localhost:5432/aeroops

# OpenSky Network - OAuth2 client credentials (compte gratuit sur opensky-network.org)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Source du pipeline Airflow : synthetic | bts
AEROOPS_SOURCE=synthetic
AEROOPS_CARRIERS=B6
